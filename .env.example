# CONFIGURACIÓN DE EJEMPLO: no contiene credenciales reales.
# Inicio recomendado: sh scripts/instalar.sh
# El instalador crea .env solo si falta y genera una clave de cifrado privada.
# Alternativa manual: cp .env.example .env; consultar CONFIGURACION.md.
# No compartir .env ni sustituir la clave de una instancia n8n ya inicializada.

# Identidad Linux para escribir Excel, logs e informes en tu carpeta.
# Consultar id -u e id -g; el instalador detecta ambos al crear .env.
LOCAL_UID=1000
LOCAL_GID=1000

# Interfaz n8n: solo accesible desde la computadora local.
N8N_PORT=5678
# Vacía en el ejemplo. El instalador la genera si crea un .env nuevo.
# Si configuras manualmente una instancia nueva sin clave, n8n la guarda
# en su volumen. Después no debes introducir una clave diferente.
N8N_ENCRYPTION_KEY=
# En modo local debe coincidir con el puerto elegido arriba.
# scripts/iniciar_tunel.sh la cambia por HTTPS para recibir Telegram.
WEBHOOK_URL=http://localhost:5678/

# PROVEEDOR PREDETERMINADO: local, sin claves de APIs comerciales.
# Valores admitidos: ollama | openai | gemini | anthropic
LLM_PROVIDER=ollama
# Referencia del modelo obligatorio, fijado también en compose.yaml.
# Cambiar esta línea por sí sola no cambia el modelo del contenedor.
OLLAMA_MODEL=gemma4:e2b-it-q4_K_M
# Tiempo máximo por solicitud, temperatura, contexto y tokens de salida.
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.2
LLM_NUM_CTX=2048
LLM_MAX_TOKENS=192

# OPCIONALES: dejar vacíos en modo local.
# Solo se usa el proveedor elegido en LLM_PROVIDER.
# Para una API se necesitan su clave y un modelo oficial de tu cuenta.
# Una suscripción a una aplicación de chat no equivale a crédito de API.
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

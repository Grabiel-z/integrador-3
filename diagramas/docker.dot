digraph DOCKER {
  graph [rankdir=TB,bgcolor="white",pad="0.25",nodesep="0.3",ranksep="0.4"];
  node [shape=box,style="rounded,filled",fillcolor="#EDF4F5",color="#183D4B",fontname="DejaVu Sans",fontsize=13];
  edge [color="#52727B",fontname="DejaVu Sans",fontsize=9];
  subgraph cluster_compose {
    label="Docker Compose\nbackend privada + salida controlada";color="#183D4B";fontname="DejaVu Sans";
    n8n [label="n8n\nlocalhost:5678"];
    db [shape=cylinder,label="SQLite n8n_data\nSin PostgreSQL adicional"];
    ai [label="AI Gateway\nSin puerto público"];
    ollama [label="Ollama\nGemma 4 E2B Q4_K_M"];
    pesos [shape=cylinder,label="ollama_data\nPesos persistentes"];
    sunat [label="SUNAT Worker\nTarea puntual"];
    report [label="Report Builder / tests\nTareas puntuales"];
    tunnel [label="Cloudflared opcional\nProxy solo webhook Telegram"];
    n8n -> ai -> ollama -> pesos; n8n -> db; tunnel -> n8n;
  }
  proveedores [label="Fuera de Docker:\nOpenAI / Gemini / Claude API",fillcolor="#FCF1D7"];
  portal [label="Portal oficial SUNAT",fillcolor="#FCF1D7"];
  ai -> proveedores [label="solo selección explícita"];
  sunat -> portal;
}

digraph DOCKER {
  graph [rankdir=TB,bgcolor="white",pad="0.2",nodesep="0.25",ranksep="0.35"];
  node [shape=box,style="rounded,filled",fillcolor="#EDF4F5",color="#183D4B",fontname="DejaVu Sans",fontsize=13];
  edge [color="#52727B",fontname="DejaVu Sans",fontsize=10];
  subgraph cluster_compose {
    label="Docker Compose: red interna y salida a fuentes";color="#183D4B";fontname="DejaVu Sans";
    n8n [label="n8n\nlocalhost:5678"];
    gateway [label="AI Gateway\nPuerto interno 8000"];
    ollama [label="Ollama\nGemma 4 E2B Q4_K_M"];
    api [label="API RUC\nlocalhost:8001"];
    worker [label="Worker RUC\nExcel + checkpoint"];
    tareas [label="Inicializadores\nPruebas e informe"];
    persistencia [shape=cylinder,label="Volúmenes persistentes\nn8n_data: SQLite\nollama_data: pesos"];
    proxy [label="Telegram opcional\nProxy + túnel"];
    {rank=same;gateway;api;}
    {rank=same;ollama;worker;tareas;}
    proxy -> n8n;
    n8n -> gateway -> ollama -> persistencia;
    n8n -> api [label="HTTP disponible"];
    n8n -> persistencia [style=dashed,constraint=false];
  }
  proveedores [label="APIs de IA opcionales\nOpenAI / Gemini / Anthropic",fillcolor="#FCF1D7"];
  fuentes [label="Fuentes del consolidado RUC\nSUNAT: SOAP y padrón oficiales\nElRUC.pe: fecha pública complementaria",fillcolor="#FCF1D7"];
  gateway -> proveedores [label="selección explícita"];
  api -> fuentes;
  worker -> fuentes;
}
